# Backend is internal to the Odoo Compose network. Never expose its API publicly.
JOBHUNTER_DATABASE_URL=postgresql+asyncpg://jobhunter:replace-in-local-env@jobhunter-postgres:5432/jobhunter
JOBHUNTER_BRIDGE_SECRET=replace-with-long-random-shared-secret
JOBHUNTER_ODOO_BASE_URL=http://odoo:8069
JOBHUNTER_OPENAI_API_KEY=
JOBHUNTER_MODEL=gpt-6.1-sol
JOBHUNTER_REASONING_EFFORT=low
# Hard ceilings are enforced by Settings; SDK and bridge do not retry.
JOBHUNTER_RUN_TIMEOUT_SECONDS=120
JOBHUNTER_BRIDGE_TIMEOUT_SECONDS=15
JOBHUNTER_MAX_PROVIDER_REQUESTS=6
JOBHUNTER_MAX_TOOL_CALLS=8

# Explicit migrated adapters (the local Compose project configures these too):
JOBHUNTER_AGENT_ADAPTERS='{"Filter":"app.agents:filter_adapter","Interview":"app.agents:interview_adapter","Report":"app.agents:report_adapter"}'
# Optional isolated Odoo host port:
JOBHUNTER_ODOO_PORT=28069
