<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rag_interview_form" model="ir.ui.view">
        <field name="name">rag.interview.form</field>
        <field name="model">rag.interview</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_rebuild_index" type="object" string="Re-index Documents" invisible="state != 'ready'"/>
                    <button name="action_retry_report" type="object" string="Retry Report" invisible="state not in ('done', 'error')"/>
                    <field name="state" widget="statusbar" statusbar_visible="ready,running,done,reported"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="applicant_id" readonly="1"/>
                            <field name="job_id"/>
                            <field name="url" widget="CopyClipboardChar" invisible="state not in ('ready', 'running')"/>
                            <field name="max_topics" readonly="state != 'ready'"/>
                            <field name="max_probes" readonly="state != 'ready'"/>
                        </group>
                        <group>
                            <field name="score" invisible="state != 'reported'"/>
                            <field name="recommendation" invisible="state != 'reported'"/>
                            <field name="cv_consistency" invisible="state != 'reported'"/>
                            <field name="flags" invisible="not flags"/>
                            <field name="error" invisible="not error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Report" invisible="state != 'reported'">
                            <group>
                                <field name="summary"/>
                                <field name="screening"/>
                                <field name="strengths"/>
                                <field name="concerns"/>
                                <field name="cv_claims"/>
                            </group>
                        </page>
                        <page string="Transcript">
                            <field name="turn_ids" readonly="1">
                                <list>
                                    <field name="topic_no"/>
                                    <field name="topic"/>
                                    <field name="question"/>
                                    <field name="answer"/>
                                    <field name="score"/>
                                    <field name="evidence" optional="hide"/>
                                    <field name="flags" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="rag_interview_list" model="ir.ui.view">
        <field name="name">rag.interview.list</field>
        <field name="model">rag.interview</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
                <field name="score"/>
                <field name="recommendation"/>
                <field name="cv_consistency"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_rag_interview" model="ir.actions.act_window">
        <field name="name">AI Interviews</field>
        <field name="res_model">rag.interview</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_rag_interview" name="AI Interviews" parent="hr_recruitment.menu_hr_recruitment_root"
              action="action_rag_interview" sequence="40"/>

    <record id="hr_applicant_form_rag" model="ir.ui.view">
        <field name="name">hr.applicant.form.rag</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_rag_interview" type="object" string="AI Interview" class="btn-secondary"
                        groups="hr_recruitment.group_hr_recruitment_user"/>
            </header>
        </field>
    </record>

    <record id="res_company_form_rag" model="ir.ui.view">
        <field name="name">res.company.form.rag</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="AI Interview" name="rag_interview">
                    <field name="rag_background" placeholder="Mission, products, culture, team, ways of working..."/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
