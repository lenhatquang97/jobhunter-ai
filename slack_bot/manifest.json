{
  "display_information": {
    "name": "Jobhunter",
    "description": "Private interview confirmation and recruiting reminders",
    "background_color": "#172B4D"
  },
  "features": {
    "bot_user": {"display_name": "Jobhunter", "always_online": false},
    "app_home": {"home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false}
  },
  "oauth_config": {"scopes": {"bot": ["chat:write", "im:write", "im:history", "users:read"]}},
  "settings": {
    "event_subscriptions": {"bot_events": ["message.im"]},
    "interactivity": {"is_enabled": true},
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
