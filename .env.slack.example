# Copy to ignored .env.slack, chmod 600, and enter secrets locally, never in chat.
# Create/install the app from slack_bot/manifest.json in the intended pilot workspace.
JOBHUNTER_SLACK_BOT_TOKEN=
# App-level token must have connections:write, with Socket Mode enabled.
JOBHUNTER_SLACK_APP_TOKEN=
JOBHUNTER_SLACK_TEAM_ID=T_REPLACE
JOBHUNTER_SLACK_HR_USER_IDS=["U_REPLACE_HR"]
JOBHUNTER_SLACK_LEAD_USER_IDS=["U_REPLACE_LEAD"]
JOBHUNTER_SLACK_OPENAI_API_KEY=
JOBHUNTER_SLACK_MODEL=gpt-6.1-sol
# URL-safe password, independent of Odoo and existing Jobhunter databases.
JOBHUNTER_SLACK_DB_PASSWORD=replace-with-independent-url-safe-password
# Compose overrides this URL with its isolated DB hostname; native runs use a local DB.
JOBHUNTER_SLACK_DATABASE_URL=postgresql+asyncpg://jobhunter_slack:replace-with-independent-url-safe-password@127.0.0.1:5432/jobhunter_slack
JOBHUNTER_SLACK_POLL_SECONDS=2
