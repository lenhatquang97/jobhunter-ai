# Backend is internal to the Odoo Compose network. Never expose its API publicly.
JOBHUNTER_DATABASE_URL=postgresql+asyncpg://jobhunter:replace-in-local-env@jobhunter-postgres:5432/jobhunter
JOBHUNTER_BRIDGE_SECRET=replace-with-long-random-shared-secret
JOBHUNTER_ODOO_BASE_URL=http://odoo:8069
JOBHUNTER_OPENAI_API_KEY=
JOBHUNTER_MODEL=gpt-6.1-sol
JOBHUNTER_REASONING_EFFORT=low
# Hard ceilings are enforced by Settings; SDK and bridge do not retry.
JOBHUNTER_RUN_TIMEOUT_SECONDS=120
JOBHUNTER_BRIDGE_TIMEOUT_SECONDS=15
JOBHUNTER_MAX_PROVIDER_REQUESTS=6
JOBHUNTER_MAX_TOOL_CALLS=8

# Explicit migrated adapters (the local Compose project configures these too):
JOBHUNTER_AGENT_ADAPTERS='{"Filter":"app.agents:filter_adapter","Schedule":"app.agents:schedule_adapter","Interview":"app.agents:interview_adapter","Report":"app.agents:report_adapter"}'
# Optional isolated Odoo host port:
JOBHUNTER_ODOO_PORT=28069

# Standalone Interview feature app (uvicorn app.standalone:app).
# These settings are intentionally separate from the orchestrated chat service above.
RECRUITER_TOKEN=replace-with-local-recruiter-token
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
INTERVIEW_DB=interviews.db
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_TRANSLATION_MODEL=qwen3.5-4b-32k-fast
TURN_MODEL=openai/gpt-4.1-mini
REPORT_MODEL=openai/gpt-4.1-mini
COPILOT_MODEL=openai/gpt-4.1-mini

# Standalone Schedule feature settings.
DATABASE_URL=
SCHEDULE_DB=schedule.db
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=hr@example.com
SCHEDULE_LIVE_EMAIL_ENABLED=false
SCHEDULE_TEST_RECIPIENT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
